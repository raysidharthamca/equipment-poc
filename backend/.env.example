# Copy to .env and fill in. Never commit .env.

# Required for the extraction pipeline (Phase 3).
ANTHROPIC_API_KEY=sk-ant-...

# Extraction model (default: fast + cheap Haiku). Override for tougher docs.
ANTHROPIC_MODEL=claude-haiku-4-5      # or claude-sonnet-5

# Database. Defaults to local SQLite if unset.
DATABASE_URL=sqlite:///./poc.db

# --- Optional alert channels (Phase 5). Left unset = channel skipped silently. ---

# Microsoft Teams incoming webhook URL.
TEAMS_WEBHOOK_URL=

# Email via SMTP (all four needed to enable SMTP sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Or email via Resend (alternative to SMTP).
RESEND_API_KEY=

# Public base URL of the React portal, used for deep links in alerts.
PORTAL_BASE_URL=http://localhost:5173

# --- Document ingestion source (no upload UI; the system reads existing files) ---
# local    = watch a local folder (LOCAL_INBOX_DIR); default, good for demo/testing
# onedrive = poll a OneDrive folder via Microsoft Graph
INGEST_SOURCE=local
LOCAL_INBOX_DIR=          # absolute path to watch; blank = ./inbox
INGEST_POLL_MINUTES=0     # >0 enables the auto-poll; 0 = manual via POST /admin/ingest-now

# Microsoft Graph app-only credentials (only for INGEST_SOURCE=onedrive).
# Register an app, grant Files.Read.All (application) with admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=           # target OneDrive drive id
GRAPH_FOLDER_PATH=        # folder within the drive, e.g. Equipment/Incoming
