# Copy to .env and fill in. Never commit .env.

# Required for the extraction pipeline (Phase 3).
ANTHROPIC_API_KEY=sk-ant-...

# Database. Defaults to local SQLite if unset.
DATABASE_URL=sqlite:///./poc.db

# --- Optional alert channels (Phase 5). Left unset = channel skipped silently. ---

# Microsoft Teams incoming webhook URL.
TEAMS_WEBHOOK_URL=

# Email via SMTP (all four needed to enable SMTP sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Or email via Resend (alternative to SMTP).
RESEND_API_KEY=

# Public base URL of the React portal, used for deep links in alerts.
PORTAL_BASE_URL=http://localhost:5173
